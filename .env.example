# Copia este archivo a `.env` y rellena lo que uses:  cp .env.example .env
# TODO es server-side: ninguna de estas variables llega al navegador.

# --- Motor CLOUD (Google Gemini) ---
# Clave de https://aistudio.google.com/apikey . Déjala vacía si solo usas LOCAL.
GEMINI_API_KEY=

# --- Motor LOCAL (Ollama, sin censura) ---
# Modelo servido por Ollama. Descárgalo antes con: ollama pull dolphin3
OLLAMA_MODEL=dolphin3
# URL del servidor Ollama. Por defecto:
#   - `npm run dev` (host)        -> http://127.0.0.1:11434
#   - Docker (contenedor)         -> http://host.docker.internal:11434
# Solo descoméntalo si necesitas forzar otra:
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Puerto ---
# Puerto donde abres AEGIS en el navegador (frontend en dev, todo-en-uno en
# Docker). Default 1337. Cámbialo si tu SO lo tiene reservado y ves
# "listen EACCES: permission denied 0.0.0.0:1337" al arrancar (típico en
# Windows con Hyper-V/WSL2/Docker: compruébalo con
# `netsh int ipv4 show excludedportrange protocol=tcp`).
# Con docker compose, este mismo valor mapea host y contenedor a la vez.
# AEGIS_PORT=3000
