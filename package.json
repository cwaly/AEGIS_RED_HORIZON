{
  "name": "aegis-red-horizon",
  "author": "César Matute",
  "description": "AEGIS: Red Horizon - AI-Powered Offensive Operations C2",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"npm:dev:server\"",
    "dev:server": "cross-env PORT=4000 tsx watch server/index.ts",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "start": "cross-env NODE_ENV=production PORT=1337 tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "tsx": "^4.19.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
